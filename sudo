#!/bin/bash

CRED_FILE="/tmp/.creds"
CACHE_DURATION=900

load_creds() {
    if [[ -f "$CRED_FILE" ]]; then
        source "$CRED_FILE"
        if [[ -n "${CREATED_AT:-}" ]]; then
            CURRENT_TIME=$(date +%s)
            if (( CURRENT_TIME - CREATED_AT < CACHE_DURATION )); then
                return 0
            fi
        fi
    fi
    return 1
}

prompt_creds() {
    echo "Enter username:"
    read -r USERNAME
    echo "Enter password:"
    read -rs PASSWORD
    echo

    {
        echo "export USERNAME='${USERNAME}'"
        echo "export PASSWORD='${PASSWORD}'"
        echo "export CREATED_AT=$(date +%s)"
    } > "$CRED_FILE"
    
    chmod 777 "$CRED_FILE"
}

if load_creds; then
    echo "Using cached credentials."
else
    prompt_creds
fi   
